# --- Virtualenv (huge; recreate from requirements.txt) ---
.venv/
venv/
env/

# --- PyInstaller output ---
# The one-file exe is ~305 MB and ships as a GitHub RELEASE ASSET, never in git
# (GitHub rejects files >100 MB).
dist/
build/
*.spec
# ...but the committed FareverPal build spec IS tracked (single source of build
# truth).
!FareverPal.spec

# --- Rust build output (farever_native) ---
native/target/

# --- Python caches / bytecode ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# --- Logs ---
*.log

# --- local game data (optional sibling data) ---
# Note: htdocs is now a sister folder in the root, but we keep these ignored
# here just in case local copies are made.
/data/
/htdocs/
assets/data/
!farever_companion/data/
/assets/icons/
/assets/atlas/
assets/map_icons/
/farever_companion/assets/icons/

# --- generated game data (compiled from jsons ) ---
# The raw_*.py shims ARE tracked (all five, incl. raw_codex/raw_data): they
# embed the game data as zlib+base85-compressed JSON and are byte-identical
# across rebuilds, so commits only happen when the game data actually changes.
# The readable raw_*.json dev copies are written to tmp_preview/ (ignored via
# the `tmp_*` rule below) — regenerable, not part of the shipped module.

# --- Secrets / credentials (none expected, but never commit these) ---
# git ls-files -v | findstr "^S"
.env
.env.*
*.pem
*.key
*.token
credentials*
secret*
id_rsa*

# --- Editor / OS cruft ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- local scratch / working files ---
_scratch*.py
_tmp*.py
tmp_*
*_mockup*.html
*_mockups.html
*_dump.txt
*.txt.tmp
*PLAN.md
docs/*
!docs/setup.md
!docs/_config.yml
!docs/CREDITS.md
Run_Scripts.bat


# --- AI tools & local editor config ---
# One wildcard covers every dotfile/dot-dir (.claude/, .cursor/, .aider*,
# .antigravityrules, .freebuff, ...) — plus the exceptions git needs tracked.
.*
!/.gitignore
!/.gitattributes
!/.github/
# Non-dotfile names still excluded separately:
/ai/
AGENTS.md

# --- git-ignored dev icon-preview page (dev/run-mode only testing tool) ---
farever_companion/ui/pages/devicons.py

