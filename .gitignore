# --- Virtualenv (huge; recreate from requirements.txt) ---
.venv/
venv/
env/

# --- PyInstaller output ---
# The one-file exe is ~305 MB and ships as a GitHub RELEASE ASSET, never in git
# (GitHub rejects files >100 MB).
dist/
build/
*.spec
# ...but the committed FareverPal build spec IS tracked (single source of build
# truth).
!FareverPal.spec

# --- Rust build output (farever_native) ---
native/target/

# --- Python caches / bytecode ---
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/

# --- Logs ---
*.log

# --- Dev-only bridge logging switches (no .log extension, so the rule
# --- above cannot match them) ---
# core/bridge_log.sync_dev_flag() writes FAREVERMOD_DEBUG_LOG beside the
# proxy DLLs on every dev-mode run and deletes it on the next non-dev run;
# its first line names the log the binaries should write. It is a local dev
# switch that points at an absolute path on this machine, never a source
# file. The _forward_only.flag / _grace_ms.txt siblings are per-DLL runtime
# levers the proxies read from next to themselves (see dps_bridge/README.md).
FAREVERMOD_DEBUG_LOG
*_forward_only.flag
*_grace_ms.txt

# --- local game data (optional sibling data) ---
# Note: htdocs is now a sister folder in the root, but we keep these ignored
# here just in case local copies are made.
/data/
/htdocs/
assets/data/
!farever_companion/data/
/assets/icons/
/assets/atlas/
assets/map_icons/
/farever_companion/assets/icons/

# --- generated game data (compiled from jsons ) ---
# The raw_*.py shims ARE tracked (all five, incl. raw_codex/raw_data): they
# embed the game data as zlib+base85-compressed JSON and are byte-identical
# across rebuilds, so commits only happen when the game data actually changes.
# The readable raw_*.json dev copies are written to tmp_preview/ (ignored via
# the `tmp_*` rule below) — regenerable, not part of the shipped module.

# --- Secrets / credentials (none expected, but never commit these) ---
# git ls-files -v | findstr "^S"
.env
.env.*
*.pem
*.key
*.token
credentials*
secret*
id_rsa*

# --- Editor / OS cruft ---
.vscode/
.idea/
Thumbs.db
desktop.ini

# --- local scratch / working files ---
# A crashed msys grep/find drops a Windows Error Reporting stack dump wherever
# it was run, which the stray-file guard then has to name as unowned scratch.
*.stackdump
_scratch*.py
_tmp*.py
tmp_*
*_mockup*.html
*_mockups.html
*_dump.txt
*.txt.tmp
*PLAN.md
docs/*
!docs/setup.md
!docs/_config.yml
!docs/CREDITS.md
# Session handoffs are deliberately NOT re-allowed: docs/ is machine-local
# working context, not a repo artifact (dropped from the index 2026-10-06).
Run_Scripts.bat


# --- AI tools & local editor config ---
# One wildcard covers every dotfile/dot-dir (.claude/, .cursor/, .aider*,
# .antigravityrules, .freebuff, ...) — plus the exceptions git needs tracked.
.*
!/.gitignore
!/.gitattributes
!/.github/
# Non-dotfile names still excluded separately:
/ai/
# AGENTS.md is kept in the repo so the agent rule is versioned and shared.

tests/scratch/
# (the dev-only icon/overlay preview page is no longer ignored here: it lives in
#  build_tools/dev/, which is tracked, and is loaded by path at runtime)

